{
  "surah": {
    "id": 107,
    "name_arabic": "سُورَةُ المَاعُونِ",
    "name_english": "Al-Maa'un",
    "name_english_translation": "Almsgiving",
    "verses_count": 7
  },
  "verses": [
    {
      "verse_number": 1,
      "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "text_english": "Have you seen the one who denies the Recompense?",
      "hadiths": []
    },
    {
      "verse_number": 2,
      "text_arabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "text_english": "For that is the one who drives away the orphan",
      "hadiths": []
    },
    {
      "verse_number": 3,
      "text_arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "text_english": "And does not encourage the feeding of the poor.",
      "hadiths": []
    },
    {
      "verse_number": 4,
      "text_arabic": "فَوَيْلٌۭ لِّلْمُصَلِّينَ",
      "text_english": "So woe to those who pray",
      "hadiths": []
    },
    {
      "verse_number": 5,
      "text_arabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "text_english": "[But] who are heedless of their prayer -",
      "hadiths": []
    },
    {
      "verse_number": 6,
      "text_arabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "text_english": "Those who make show [of their deeds]",
      "hadiths": []
    },
    {
      "verse_number": 7,
      "text_arabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "text_english": "And withhold [simple] assistance.",
      "hadiths": []
    }
  ]
}