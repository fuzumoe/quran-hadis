{
  "surah": {
    "id": 104,
    "name_arabic": "سُورَةُ الهُمَزَةِ",
    "name_english": "Al-Humaza",
    "name_english_translation": "The Traducer",
    "verses_count": 9
  },
  "verses": [
    {
      "verse_number": 1,
      "text_arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "text_english": "Woe to every scorner and mocker",
      "hadiths": []
    },
    {
      "verse_number": 2,
      "text_arabic": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "text_english": "Who collects wealth and [continuously] counts it.",
      "hadiths": []
    },
    {
      "verse_number": 3,
      "text_arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "text_english": "He thinks that his wealth will make him immortal.",
      "hadiths": []
    },
    {
      "verse_number": 4,
      "text_arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "text_english": "No! He will surely be thrown into the Crusher.",
      "hadiths": []
    },
    {
      "verse_number": 5,
      "text_arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "text_english": "And what can make you know what is the Crusher?",
      "hadiths": []
    },
    {
      "verse_number": 6,
      "text_arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "text_english": "It is the fire of Allah, [eternally] fueled,",
      "hadiths": []
    },
    {
      "verse_number": 7,
      "text_arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "text_english": "Which mounts directed at the hearts.",
      "hadiths": []
    },
    {
      "verse_number": 8,
      "text_arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",
      "text_english": "Indeed, Hellfire will be closed down upon them",
      "hadiths": []
    },
    {
      "verse_number": 9,
      "text_arabic": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",
      "text_english": "In extended columns.",
      "hadiths": []
    }
  ]
}